if(NIJIGENERATE_IMGUI AND TARGET SDL3::SDL3)
    add_library(nijigenerate_renderer_declarations INTERFACE)
    target_include_directories(nijigenerate_renderer_declarations INTERFACE "${CMAKE_CURRENT_SOURCE_DIR}/src")
    target_link_libraries(nijigenerate_renderer_declarations INTERFACE
        nijigenerate_native_options SDL3::SDL3 nijigenerate_imgui nijigenerate_dpi)
    if(NIJIGENERATE_RENDERER STREQUAL "METAL")
        set(_ng_renderer_source src/nijigenerate/backend/metal/renderer.mm)
        set(_ng_renderer_backend nijigenerate_metal)
    else()
        set(_ng_renderer_source src/nijigenerate/backend/renderer.cpp)
        set(_ng_renderer_backend nijigenerate_vulkan)
    endif()
    add_library(nijigenerate_renderer STATIC ${_ng_renderer_source})
    if(NIJIGENERATE_RENDERER STREQUAL "METAL")
        target_compile_options(nijigenerate_renderer PRIVATE -fobjc-arc)
    endif()
    target_link_libraries(nijigenerate_renderer PUBLIC nijigenerate_renderer_declarations
        ${_ng_renderer_backend} nijigenerate_debug PRIVATE nijigenerate_imgui_sdl3)
endif()
