set(NIJIGENERATE_VERSION_OVERRIDE "" CACHE STRING "Explicit native version; empty reads the current version.txt")
set(NIJIGENERATE_SOURCE_REVISION "" CACHE STRING "Explicit provenance revision; never inferred using Git")
set(NIJIGENERATE_BUILD_CHANNEL "development" CACHE STRING "Explicit native distribution channel")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/version.txt")
if(NIJIGENERATE_VERSION_OVERRIDE STREQUAL "")
    file(READ "${PROJECT_SOURCE_DIR}/version.txt" NG_METADATA_VERSION)
    string(STRIP "${NG_METADATA_VERSION}" NG_METADATA_VERSION)
    file(SHA256 "${PROJECT_SOURCE_DIR}/version.txt" NG_METADATA_VERSION_SOURCE_SHA256)
    set(NG_METADATA_VERSION_SOURCE "version.txt")
else()
    set(NG_METADATA_VERSION "${NIJIGENERATE_VERSION_OVERRIDE}")
    set(NG_METADATA_VERSION_SOURCE "explicit override")
    set(NG_METADATA_VERSION_SOURCE_SHA256 "")
endif()
set(NG_METADATA_REVISION "${NIJIGENERATE_SOURCE_REVISION}")
set(NG_METADATA_CHANNEL "${NIJIGENERATE_BUILD_CHANNEL}")
foreach(metadata_key IN ITEMS VERSION CHANNEL REVISION)
    if(metadata_key STREQUAL "REVISION" AND NG_METADATA_REVISION STREQUAL "")
        continue()
    endif()
    if(NOT NG_METADATA_${metadata_key} MATCHES "^[A-Za-z0-9][A-Za-z0-9._+/-]*$")
        message(FATAL_ERROR "Invalid explicit version metadata: ${metadata_key}")
    endif()
endforeach()
set(metadata_include "${CMAKE_CURRENT_BINARY_DIR}/generated/include")
configure_file("${CMAKE_CURRENT_LIST_DIR}/templates/version_metadata.hpp.in"
    "${metadata_include}/nijigenerate/version_metadata.hpp" @ONLY)
configure_file("${CMAKE_CURRENT_LIST_DIR}/templates/version_metadata.json.in"
    "${CMAKE_CURRENT_BINARY_DIR}/generated/version_metadata.json" @ONLY)
add_library(nijigenerate_version_metadata INTERFACE)
target_include_directories(nijigenerate_version_metadata INTERFACE "${metadata_include}")
target_link_libraries(nijigenerate_version_metadata INTERFACE nijigenerate_native_options)
if(BUILD_TESTING)
    add_executable(nijigenerate_version_metadata_probe "${CMAKE_CURRENT_LIST_DIR}/tests/version_metadata_probe.cpp")
    target_link_libraries(nijigenerate_version_metadata_probe PRIVATE nijigenerate_version_metadata)
    add_test(NAME native_version_metadata COMMAND nijigenerate_version_metadata_probe
        "${NG_METADATA_VERSION}" "${NG_METADATA_REVISION}" "${NG_METADATA_CHANNEL}")
endif()
