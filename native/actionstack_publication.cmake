# Publish the one real actionstack implementation already owned by runtime_core.
function(ng_publish_actionstack)
    if(NOT TARGET nijigenerate_runtime_core OR NOT TARGET nicxlive::common)
        message(FATAL_ERROR "Action stack publication requires its actual runtime and SDK providers")
    endif()
    get_target_property(actionstack_sources nijigenerate_runtime_core SOURCES)
    set(actionstack_selected FALSE)
    foreach(source IN LISTS actionstack_sources)
        if(source MATCHES "(^|/)core/actionstack[.]cpp$")
            set(actionstack_selected TRUE)
        endif()
    endforeach()
    if(NOT actionstack_selected)
        message(FATAL_ERROR "Action stack publication requires the actual core/actionstack.cpp producer")
    endif()
    get_target_property(published nijigenerate_runtime_core NG_ACTIONSTACK_PUBLISHED)
    if(NOT published)
        target_sources(nijigenerate_runtime_core PUBLIC FILE_SET actionstack_headers TYPE HEADERS
            BASE_DIRS "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/src"
            FILES "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/src/nijigenerate/core/actionstack.hpp")
        target_link_libraries(nijigenerate_runtime_core PUBLIC nicxlive::common)
        set_property(TARGET nijigenerate_runtime_core PROPERTY NG_ACTIONSTACK_PUBLISHED TRUE)
    endif()
endfunction()
