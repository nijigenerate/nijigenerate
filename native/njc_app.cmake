include_guard(GLOBAL)

# AUTO preserves the existing optional CLI; ON requires its actual providers.
set(NIJIGENERATE_NJC "AUTO" CACHE STRING "Build njc: AUTO, ON or OFF")
set_property(CACHE NIJIGENERATE_NJC PROPERTY STRINGS AUTO ON OFF)
if(NOT NIJIGENERATE_NJC MATCHES "^(AUTO|ON|OFF)$")
    message(FATAL_ERROR "NIJIGENERATE_NJC must be AUTO, ON or OFF")
endif()
if(NIJIGENERATE_NJC STREQUAL "OFF")
    return()
endif()
if(TARGET nijigenerate_njc)
    message(FATAL_ERROR "The njc executable target is already defined outside its dedicated module")
endif()
if(NOT TARGET nijigenerate_njc_commands)
    if(NIJIGENERATE_NJC STREQUAL "ON")
        message(FATAL_ERROR "Requested njc requires the actual nijigenerate_njc_commands target")
    endif()
    message(STATUS "njc is unavailable: its actual command provider target is not configured")
    return()
endif()
if(NOT TARGET nijigenerate_native_options)
    message(FATAL_ERROR "The njc executable requires the actual native compile-policy target")
endif()
set(njc_entry_source "${CMAKE_CURRENT_LIST_DIR}/src/njc/app.cpp")
if(NOT EXISTS "${njc_entry_source}" OR IS_DIRECTORY "${njc_entry_source}")
    message(FATAL_ERROR "The actual njc entry translation unit is missing: ${njc_entry_source}")
endif()

add_executable(nijigenerate_njc "${njc_entry_source}")
target_compile_features(nijigenerate_njc PRIVATE cxx_std_20)
target_link_libraries(nijigenerate_njc PRIVATE nijigenerate_njc_commands nijigenerate_native_options)
set_target_properties(nijigenerate_njc PROPERTIES OUTPUT_NAME njc)
if(MINGW)
    target_link_options(nijigenerate_njc PRIVATE -municode)
endif()
