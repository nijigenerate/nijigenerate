private void testParameterKeyframeCommandUndoRedo() {
    resetCase();

    auto node = new Node(incActivePuppet().root);
    auto param = new ExParameter("Param", true);
    param.min = vec2(-1, -1);
    param.max = vec2(1, 1);
    param.insertAxisPoint(0, 0.5f);
    param.insertAxisPoint(1, 0.5f);
