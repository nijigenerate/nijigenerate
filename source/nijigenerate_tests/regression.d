private void testMcpResourceListingAndContextHelpers() {
    resetCase();

    auto puppet = incActivePuppet();
    auto node = new Node(puppet.root);
    node.name = "MCPNode";
    auto child = new Node(node);
    child.name = "MCPChild";

    auto param = new ExParameter("MCPParam", false);
