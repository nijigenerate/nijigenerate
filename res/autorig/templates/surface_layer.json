{
  "schema_version": "semantic-grid-template/1",
  "id": "surface_layer",
  "version": "1.0.0",
  "family": "host_attached",
  "label": "共有宿主へ付着する密着面・帯・影",
  "frame": {
    "u": "中立素材の局所横方向。画面左右と人体左右は同一視しない。",
    "v": "意味付き基準線の始点から終点。中立素材へのfitで傾きと非対称を保持。",
    "depth_units": "bounds_width",
    "angle_unit": "degree"
  },
  "landmarks": [
    {
      "id": "host_anchor",
      "uv": [
        0.5,
        0.5
      ],
      "required": true,
      "candidate_sources": [
        "existing_attachment",
        "part_registration",
        "neutral_hint"
      ],
      "meaning": "宿主上の対応点"
    },
    {
      "id": "edge_a",
      "uv": [
        0,
        0.5
      ],
      "required": false,
      "candidate_sources": [
        "alpha_contour",
        "neutral_hint"
      ],
      "meaning": "素材の一方の側縁"
    },
    {
      "id": "edge_b",
      "uv": [
        1,
        0.5
      ],
      "required": false,
      "candidate_sources": [
        "alpha_contour",
        "neutral_hint"
      ],
      "meaning": "素材の反対側縁"
    }
  ],
  "guide_grid": {
    "rows": [
      {
        "id": "upper",
        "v": 0,
        "landmark_roles": []
      },
      {
        "id": "mid",
        "v": 0.5,
        "landmark_roles": []
      },
      {
        "id": "lower",
        "v": 1,
        "landmark_roles": []
      }
    ],
    "columns": [
      {
        "id": "side_a",
        "u": 0,
        "landmark_roles": []
      },
      {
        "id": "quarter_a",
        "u": 0.25,
        "landmark_roles": []
      },
      {
        "id": "center",
        "u": 0.5,
        "landmark_roles": []
      },
      {
        "id": "quarter_b",
        "u": 0.75,
        "landmark_roles": []
      },
      {
        "id": "side_b",
        "u": 1,
        "landmark_roles": []
      }
    ],
    "patches": []
  },
  "geometry": {
    "representation": "front_chart",
    "depth_mode": "host_offset",
    "operators": [
      {
        "type": "host_offset",
        "offset": "layer_offset"
      }
    ]
  },
  "tunables": [
    {
      "id": "layer_offset",
      "default": 0.01,
      "min": -0.03,
      "max": 0.1,
      "unit": "bounds_width",
      "meaning": "host_depthへ加えるchart方向の局所深度離隔。法線offsetではない"
    }
  ],
  "attachment_slots": [
    {
      "id": "host",
      "region": {
        "u": [
          0,
          1
        ],
        "v": [
          0,
          1
        ]
      },
      "host_role": "registered_host_surface",
      "mode": "surface_follow",
      "implementation": "metadata_only"
    }
  ],
  "drivers": [
    {
      "id": "chart_rotation",
      "kind": "rigid_rotation",
      "inputs": [
        "yaw",
        "pitch",
        "roll"
      ],
      "implementation": "implemented"
    },
    {
      "id": "host_follow",
      "kind": "surface_follow",
      "inputs": [
        "host_pose",
        "host_material_coordinates"
      ],
      "implementation": "planned"
    }
  ],
  "correction_rules": [],
  "hints": {
    "required": [
      "host_anchor"
    ],
    "optional": [
      "edge_a",
      "edge_b"
    ]
  },
  "validation": {
    "neutral_tolerance_width": 1e-7,
    "landmark_tolerance_width": 0.005,
    "minimum_signed_cell_area": 1e-12,
    "max_depth_width": 2,
    "require_monotone_grid_axes": true,
    "require_no_new_cell_inversion": true,
    "require_resolved_hints_for_source_fit": true,
    "forbid_hidden_surface_claim": true
  },
  "capabilities": {
    "implemented": [
      "front_chart_depth",
      "guide_grid_from_bounds_or_supplied_landmarks",
      "rigid_chart_rotation",
      "local_pose_correction"
    ],
    "planned": [
      "automatic_semantic_landmark_extraction",
      "attachment_constraint_solver",
      "host_contact_solver",
      "NJC_compiler",
      "normal_offset_surface_registration",
      "material_coordinate_transport"
    ],
    "required_runtime_inputs": [
      "host_depth"
    ]
  },
  "limitations": [
    "深度既定値は版固定の事前値であり、中立画像から観測した真の奥行きではない。",
    "本版は可視front chartのfit・深度・剛体回転・局所補正の計算である。接合slotは宣言のみで、骨接合・contact・物理を解いたとは扱わない。",
    "各chartを単独回転したpreviewは全rigの合成結果ではない。未提供の裏面や隠れた塗り面は生成しない。",
    "host_depthは同じuv/material correspondence、同じbounds_width単位へ変換した配列が必須。未提供時はfailし、ゼロhostを仮定しない。",
    "現host_offset演算はscalar depth加算。真の法線方向offsetと再登録は未実装である。影の場合はlayer_offset=0を明示しgeometryを増やさない。"
  ]
}
