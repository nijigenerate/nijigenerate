{
  "schema_version": "semantic-grid-template/1",
  "id": "neck",
  "version": "1.0.0",
  "family": "anatomical_surface",
  "label": "頭側と胸側を接続する首の格子",
  "frame": {
    "u": "中立素材の局所横方向。画面左右と人体左右は同一視しない。",
    "v": "意味付き基準線の始点から終点。中立素材へのfitで傾きと非対称を保持。",
    "depth_units": "bounds_width",
    "angle_unit": "degree"
  },
  "landmarks": [
    {
      "id": "upper_center",
      "uv": [
        0.5,
        0
      ],
      "required": true,
      "candidate_sources": [
        "existing_attachment",
        "existing_bone",
        "neutral_hint"
      ],
      "meaning": "顎の後ろへ入る首上端。顎先ではない"
    },
    {
      "id": "base_center",
      "uv": [
        0.5,
        1
      ],
      "required": true,
      "candidate_sources": [
        "existing_attachment",
        "existing_bone",
        "neutral_hint"
      ],
      "meaning": "胸側の首基部"
    },
    {
      "id": "side_a",
      "uv": [
        0,
        0.5
      ],
      "required": false,
      "candidate_sources": [
        "alpha_contour",
        "neutral_hint"
      ],
      "meaning": "一方の首側縁"
    },
    {
      "id": "side_b",
      "uv": [
        1,
        0.5
      ],
      "required": false,
      "candidate_sources": [
        "alpha_contour",
        "neutral_hint"
      ],
      "meaning": "反対の首側縁"
    }
  ],
  "guide_grid": {
    "rows": [
      {
        "id": "hidden_upper",
        "v": 0,
        "landmark_roles": [
          "upper_center"
        ]
      },
      {
        "id": "upper_neck",
        "v": 0.3,
        "landmark_roles": []
      },
      {
        "id": "lower_neck",
        "v": 0.65,
        "landmark_roles": []
      },
      {
        "id": "chest_root",
        "v": 1,
        "landmark_roles": [
          "base_center"
        ]
      }
    ],
    "columns": [
      {
        "id": "side_a",
        "u": 0,
        "landmark_roles": []
      },
      {
        "id": "quarter_a",
        "u": 0.25,
        "landmark_roles": []
      },
      {
        "id": "center",
        "u": 0.5,
        "landmark_roles": []
      },
      {
        "id": "quarter_b",
        "u": 0.75,
        "landmark_roles": []
      },
      {
        "id": "side_b",
        "u": 1,
        "landmark_roles": []
      }
    ],
    "patches": []
  },
  "geometry": {
    "representation": "front_chart",
    "depth_mode": "independent",
    "operators": [
      {
        "type": "section_surface",
        "depth": "neck_depth",
        "depth_profile": [
          [
            0,
            0.8
          ],
          [
            0.3,
            0.9
          ],
          [
            0.65,
            1
          ],
          [
            1,
            1.2
          ]
        ],
        "center_u": 0.5,
        "radius_u": 0.5,
        "exponent": 0.5,
        "base": 0,
        "cross_section": "ellipse"
      },
      {
        "type": "bend",
        "amplitude": "neck_curve",
        "axis": "v",
        "power": 2,
        "origin": 0.5
      }
    ]
  },
  "tunables": [
    {
      "id": "neck_depth",
      "default": 0.22,
      "min": 0.04,
      "max": 0.6,
      "unit": "bounds_width",
      "meaning": "首断面の奥行き"
    },
    {
      "id": "neck_curve",
      "default": 0.015,
      "min": -0.15,
      "max": 0.15,
      "unit": "bounds_width",
      "meaning": "基部から上端への反り"
    },
    {
      "id": "width_keep",
      "default": 0.025,
      "min": 0,
      "max": 0.1,
      "unit": "bounds_width",
      "meaning": "回転時の首幅補正"
    }
  ],
  "attachment_slots": [
    {
      "id": "head",
      "region": {
        "u": [
          0.15,
          0.85
        ],
        "v": [
          0,
          0
        ]
      },
      "host_role": "head_neck_attachment",
      "mode": "shared_seam",
      "implementation": "metadata_only"
    },
    {
      "id": "chest",
      "region": {
        "u": [
          0,
          1
        ],
        "v": [
          1,
          1
        ]
      },
      "host_role": "torso_neck_base",
      "mode": "shared_seam",
      "implementation": "metadata_only"
    }
  ],
  "drivers": [
    {
      "id": "chart_rotation",
      "kind": "rigid_rotation",
      "inputs": [
        "yaw",
        "pitch",
        "roll"
      ],
      "implementation": "implemented"
    },
    {
      "id": "head_chest_blend",
      "kind": "joint_chain",
      "inputs": [
        "head",
        "neck",
        "chest"
      ],
      "implementation": "planned"
    }
  ],
  "correction_rules": [
    {
      "type": "local",
      "center": [
        0.12,
        0.5
      ],
      "radius": [
        0.28,
        0.5
      ],
      "direction": [
        -1,
        0
      ],
      "amplitude": "width_keep",
      "driver": {
        "axis": "yaw",
        "basis": "sin2",
        "scale": 1
      },
      "pin_edges": [
        "v0",
        "v1"
      ]
    },
    {
      "type": "local",
      "center": [
        0.88,
        0.5
      ],
      "radius": [
        0.28,
        0.5
      ],
      "direction": [
        1,
        0
      ],
      "amplitude": "width_keep",
      "driver": {
        "axis": "yaw",
        "basis": "sin2",
        "scale": 1
      },
      "pin_edges": [
        "v0",
        "v1"
      ]
    }
  ],
  "hints": {
    "required": [
      "upper_center",
      "base_center"
    ],
    "optional": [
      "side_a",
      "side_b"
    ]
  },
  "validation": {
    "neutral_tolerance_width": 1e-7,
    "landmark_tolerance_width": 0.005,
    "minimum_signed_cell_area": 1e-12,
    "max_depth_width": 2,
    "require_monotone_grid_axes": true,
    "require_no_new_cell_inversion": true,
    "require_resolved_hints_for_source_fit": true,
    "forbid_hidden_surface_claim": true
  },
  "capabilities": {
    "implemented": [
      "front_chart_depth",
      "guide_grid_from_bounds_or_supplied_landmarks",
      "rigid_chart_rotation",
      "local_pose_correction"
    ],
    "planned": [
      "automatic_semantic_landmark_extraction",
      "attachment_constraint_solver",
      "host_contact_solver",
      "NJC_compiler"
    ],
    "required_runtime_inputs": []
  },
  "limitations": [
    "深度既定値は版固定の事前値であり、中立画像から観測した真の奥行きではない。",
    "本版は可視front chartのfit・深度・剛体回転・局所補正の計算である。接合slotは宣言のみで、骨接合・contact・物理を解いたとは扱わない。",
    "各chartを単独回転したpreviewは全rigの合成結果ではない。未提供の裏面や隠れた塗り面は生成しない。",
    "上端を可視の顎線へWeldしない。頭/胸の合成接続はmetadataであり単独previewで検証済みにならない。"
  ]
}
