      "mode": "fixed_band",
      "implementation": "metadata_only"
    },
    {
      "id": "cuff",
      "region": {
        "u": [
          0,
          1
        ],
        "v": [
          1,
          1
        ]
      },
      "host_role": "forearm_cuff",
      "mode": "fixed_band",
      "implementation": "metadata_only"
    }
  ],
  "drivers": [
    {
      "id": "chart_rotation",
      "kind": "rigid_rotation",
      "inputs": [
        "yaw",
        "pitch",
        "roll"
      ],
      "implementation": "implemented"
    },
    {
      "id": "arm_cloth",
      "kind": "cloth_contact",
      "inputs": [
        "arm_pose",
        "root_frame",
        "cuff_frame",
        "gravity"
      ],
      "implementation": "planned"
    }
  ],
  "correction_rules": [
    {
      "type": "local",
      "center": [
        0.12,
        0.5
      ],
      "radius": [
        0.26,
        0.45
      ],
      "direction": [
        -1,
        0
      ],
      "amplitude": "puff_keep",
      "driver": {
        "axis": "yaw",
        "basis": "sin2",
        "scale": 1
      },
      "pin_edges": [
        "v0",
        "v1"
      ]
    },
    {
      "type": "local",
      "center": [
        0.88,
        0.5
      ],
      "radius": [
        0.26,
        0.45
      ],
      "direction": [
        1,
        0
      ],
      "amplitude": "puff_keep",
      "driver": {
        "axis": "yaw",
        "basis": "sin2",
        "scale": 1
      },
      "pin_edges": [
        "v0",
        "v1"
      ]
    }
