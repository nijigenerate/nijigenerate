    {
      "id": "limb_depth",
      "default": 0.24,
      "min": 0.03,
      "max": 0.65,
      "unit": "bounds_width",
      "meaning": "断面の奥行き"
    },
    {
      "id": "joint_relief",
      "default": 0.012,
      "min": -0.03,
      "max": 0.1,
      "unit": "bounds_width",
      "meaning": "関節帯の局所的な厚み"
    },
    {
      "id": "joint_outline",
      "default": 0.02,
      "min": 0,
      "max": 0.12,
      "unit": "bounds_width",
      "meaning": "関節帯の回転後輪郭保持"
    }
  ],
  "attachment_slots": [
    {
      "id": "root",
      "region": {
        "u": [
          0.15,
          0.85
        ],
        "v": [
          0,
          0
        ]
      },
      "host_role": "shoulder_socket",
      "mode": "joint",
      "implementation": "metadata_only"
    },
    {
      "id": "end",
      "region": {
        "u": [
          0.2,
          0.8
        ],
        "v": [
          1,
          1
        ]
      },
      "host_role": "hand_wrist",
      "mode": "shared_seam",
      "implementation": "metadata_only"
    }
  ],
  "drivers": [
    {
      "id": "chart_rotation",
      "kind": "rigid_rotation",
      "inputs": [
        "yaw",
        "pitch",
        "roll"
      ],
      "implementation": "implemented"
    },
    {
      "id": "two_bone_chain",
      "kind": "joint_chain",
      "inputs": [
        "root_rotation",
        "joint_flexion",
        "twist",
        "end_target"
      ],
      "implementation": "planned"
    }
  ],
  "correction_rules": [
    {
      "type": "local",
      "center": [
        0.1,
        0.5
      ],
      "radius": [
        0.3,
        0.23
      ],
      "direction": [
        -1,
        0
      ],
      "amplitude": "joint_outline",
      "driver": {
        "axis": "pitch",
        "basis": "sin2",
        "scale": 1
      },
      "pin_edges": [
        "v0",
        "v1"
      ]
    },
    {
      "type": "local",
      "center": [
        0.9,
        0.5
      ],
      "radius": [
        0.3,
        0.23
      ],
      "direction": [
        1,
        0
      ],
      "amplitude": "joint_outline",
      "driver": {
        "axis": "pitch",
        "basis": "sin2",
        "scale": 1
      },
      "pin_edges": [
        "v0",
        "v1"
      ]
    }
  ],
  "hints": {
    "required": [
      "root",
      "joint",
      "end"
    ],
    "optional": [
      "bend_side"
    ]
  },
  "validation": {
    "neutral_tolerance_width": 1e-7,
    "landmark_tolerance_width": 0.005,
    "minimum_signed_cell_area": 1e-12,
    "max_depth_width": 2,
    "require_monotone_grid_axes": true,
    "require_no_new_cell_inversion": true,
    "require_resolved_hints_for_source_fit": true,
    "forbid_hidden_surface_claim": true
  },
  "capabilities": {
    "implemented": [
      "front_chart_depth",
      "guide_grid_from_bounds_or_supplied_landmarks",
      "rigid_chart_rotation",
      "local_pose_correction"
    ],
    "planned": [
      "automatic_semantic_landmark_extraction",
      "attachment_constraint_solver",
      "host_contact_solver",
      "NJC_compiler",
      "two_bone_IK",
      "fixed_bone_length_constraint",
      "joint_volume_preservation"
    ],
    "required_runtime_inputs": []
  },
  "limitations": [
    "深度既定値は版固定の事前値であり、中立画像から観測した真の奥行きではない。",
    "本版は可視front chartのfit・深度・剛体回転・局所補正の計算である。接合slotは宣言のみで、骨接合・contact・物理を解いたとは扱わない。",
    "各chartを単独回転したpreviewは全rigの合成結果ではない。未提供の裏面や隠れた塗り面は生成しない。",
    "本版の回転はchart単体。二節IK・関節長保持・局所曲げはplannedで、rig済み四肢だとは扱わない。",
    "骨sideを素材L/R接尾辞から推定せず、既存骨と中立の対応で確定する。"
  ]
}
