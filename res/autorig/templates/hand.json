      "region": {
        "u": [
          0.3,
          0.7
        ],
        "v": [
          0,
          0
        ]
      },
      "host_role": "arm_end",
      "mode": "shared_seam",
      "implementation": "metadata_only"
    }
  ],
  "drivers": [
    {
      "id": "chart_rotation",
      "kind": "rigid_rotation",
      "inputs": [
        "yaw",
        "pitch",
        "roll"
      ],
      "implementation": "implemented"
    },
    {
      "id": "finger_branches",
      "kind": "joint_chain",
      "inputs": [
        "finger_flexion",
        "finger_spread"
      ],
      "implementation": "planned"
    }
  ],
  "correction_rules": [
    {
      "type": "local",
      "center": [
        0.1,
        0.6
      ],
      "radius": [
        0.22,
        0.4
      ],
      "direction": [
        -1,
        0
      ],
      "amplitude": "palm_width_keep",
      "driver": {
        "axis": "yaw",
        "basis": "sin2",
        "scale": 1
      },
      "pin_edges": [
        "v0"
      ]
    },
    {
      "type": "local",
      "center": [
        0.9,
        0.6
      ],
      "radius": [
        0.22,
        0.4
      ],
      "direction": [
        1,
        0
      ],
      "amplitude": "palm_width_keep",
      "driver": {
        "axis": "yaw",
        "basis": "sin2",
        "scale": 1
