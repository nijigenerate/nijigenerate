  "tunables": [
    {
      "id": "palm_depth",
      "default": 0.1,
      "min": 0.01,
      "max": 0.3,
      "unit": "bounds_width",
      "meaning": "掌の厚み"
    },
    {
      "id": "thumb_base_relief",
      "default": 0.035,
      "min": 0,
      "max": 0.12,
