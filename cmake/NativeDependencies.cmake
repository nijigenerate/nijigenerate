if(NOT EXISTS "${NIJIGENERATE_NICXLIVE_SOURCE_DIR}/CMakeLists.txt")
    message(FATAL_ERROR "Set NIJIGENERATE_NICXLIVE_SOURCE_DIR to an existing local nicxlive checkout.")
endif()
find_package(SDL3 CONFIG REQUIRED)
find_package(Vulkan REQUIRED COMPONENTS glslc)
find_package(Boost CONFIG REQUIRED COMPONENTS json)
set(NICXLIVE_BUILD_SHARED OFF CACHE BOOL "" FORCE)
# Retain the effective SDK test predicate from the former outer probe gate.
if(NIJIGENERATE_RUNTIME_PROBE AND BUILD_TESTING)
    set(NICXLIVE_BUILD_TESTS ON CACHE BOOL "" FORCE)
else()
    set(NICXLIVE_BUILD_TESTS OFF CACHE BOOL "" FORCE)
endif()
set(NICXLIVE_ENABLE_FAST_MATH OFF CACHE BOOL "" FORCE)
set(NICXLIVE_ENABLE_AVX2 OFF CACHE BOOL "" FORCE)
add_subdirectory("${NIJIGENERATE_NICXLIVE_SOURCE_DIR}" "${PROJECT_BINARY_DIR}/nicxlive")
if(MSVC)
    target_compile_options(nicxlive PRIVATE /utf-8)
endif()
